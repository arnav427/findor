# GEMINI_API_KEY: Server-side key for optional AI semantic matching, image analysis, and natural language discovery.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Public client-side Google Maps Platform key (restricted by HTTP referrer and Maps JS + Places API).
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# APP_URL: The base URL where Findora is hosted.
APP_URL="http://localhost:3000"

# Optional external SMS/Email provider configuration (uses built-in verification inbox when unconfigured):
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
# SMTP_HOST=""
# SMTP_USER=""
# SMTP_PASS=""

